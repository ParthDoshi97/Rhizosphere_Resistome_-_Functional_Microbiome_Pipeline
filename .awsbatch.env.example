# Copy this file to .awsbatch.env and fill in local secrets.
# .awsbatch.env is intentionally ignored and must not be committed.

export TOWER_ACCESS_TOKEN='replace_with_seqera_access_token'
export TOWER_API_ENDPOINT='https://api.cloud.seqera.io'

# Optional: set this when launching into a shared Seqera workspace.
# export TOWER_WORKSPACE_ID='replace_with_workspace_id'

# Optional AWS Batch defaults written by scripts/setup_awsbatch*.sh.
# export AWS_REGION='ap-south-1'
# export NXF_AWS_BATCH_QUEUE='rhizo-spot-queue'
# export NXF_AWS_WORKDIR='s3://bucket/prefix/nxf-work'
# export NXF_AWS_OUTDIR='s3://bucket/prefix/results'
