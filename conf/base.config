params {
    input  = null
    outdir = 'results'

    publish_dir_mode = 'copy'
    save_logs        = true
    save_trimmed     = false
    save_bam         = false

    skip_multiqc = false
    skip_plass   = false

    // fastp QC gate
    fastp_min_reads      = 500000
    fastp_min_bases_gbp  = 0.5
    fastp_min_q30_rate   = 0.70
    fastp_max_dup_rate   = 0.40
    fastp_min_gc         = 0.40
    fastp_max_gc         = 0.75
    fastp_depth_fraction = 0.30
    fastp_extra_args     = ''

    // MEGAHIT assembly
    megahit_min_contig_len = 1000
    megahit_extra_args     = ''

    // Assembly QC gate
    assembly_min_bases_mbp   = 50
    assembly_min_n50_bp      = 1000
    assembly_min_contigs_1kb = 5000
    assembly_max_contigs     = 2000000

    // Plass protein assembly
    plass_min_protein_len = 45
    plass_extra_args      = ''

    // CoverM coverage profiling
    coverm_min_identity    = 0.95
    coverm_min_aligned_len = 50
    coverm_extra_args      = ''
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
}

process {
    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = {
        task.exitStatus in [104, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143, 144, 145, 175, 176, 177]
            ? 'retry'
            : 'finish'
    }
    maxRetries = 1
    maxErrors  = '-1'

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: 'process_low' {
        cpus   = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: 'process_medium' {
        cpus   = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withLabel: 'process_high' {
        cpus   = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    withLabel: 'process_high_memory' {
        cpus   = { 12 * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withLabel: 'process_long' {
        time = { 24.h * task.attempt }
    }

    withLabel: 'error_retry' {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

profiles {
    test {
        params {
            input  = "${projectDir}/test_data/sample_sheet.csv"
            outdir = 'results/test'

            fastp_min_reads      = 1
            fastp_min_bases_gbp  = 0
            fastp_min_q30_rate   = 0
            fastp_max_dup_rate   = 1
            fastp_min_gc         = 0
            fastp_max_gc         = 1

            assembly_min_bases_mbp   = 0
            assembly_min_n50_bp      = 1
            assembly_min_contigs_1kb = 0
            assembly_max_contigs     = 10000000
        }
    }

    test_full {
        params {
            input  = "${projectDir}/data/PRJNA647806/sample_sheet.csv"
            outdir = 'results/test_full'
        }
    }

    docker {
        docker.enabled      = true
        conda.enabled       = false
        singularity.enabled = false
        apptainer.enabled   = false
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
        apptainer.enabled      = false
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        conda.enabled        = false
        singularity.enabled  = false
    }

    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
}
