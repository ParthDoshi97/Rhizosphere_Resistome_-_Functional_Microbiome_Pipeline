params {
    input  = 's3://nf-pipeline-data/Data/PRJNA647806/sample_sheet.csv'
    outdir = 's3://nf-pipeline-data/Data/PRJNA647806/results'

    fastp_min_reads      = 500000
    fastp_min_bases_gbp  = 0.5
    fastp_min_q30_rate   = 0.70
    fastp_max_dup_rate   = 0.40
    fastp_min_gc         = 0.40
    fastp_max_gc         = 0.75
    fastp_depth_fraction = 0.30

    // MEGAHIT assembly
    megahit_min_contig_len   = 1000

    // Assembly QC gate
    assembly_min_bases_mbp   = 50
    assembly_min_n50_bp      = 1000
    assembly_min_contigs_1kb = 5000
    assembly_max_contigs     = 2000000

    // Plass protein assembly
    plass_min_protein_len    = 45

    // CoverM coverage profiling
    coverm_min_identity      = 0.95
    coverm_min_aligned_len   = 50
    save_bam                 = false
}

process {
    withLabel: 'process_medium' {
        cpus   = 16
        memory = 32.GB
        time   = 4.h
    }

    withLabel: 'process_single' {
        cpus   = 1
        memory = 6.GB
        time   = 1.h
    }

    withLabel: 'process_high' {
        cpus   = 16
        memory = 120.GB
        time   = 8.h
    }

    withLabel: 'process_high_memory' {
        cpus   = 16
        memory = 180.GB
        time   = 12.h
    }
}
