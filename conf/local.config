/*
 * Local / WSL execution profile
 * Conservative WSL profile for laptops where Docker/WSL exposes ~6-7 GB RAM.
 * Runs processes sequentially (no cloud parallelism).
 * For full soil metagenomes, increase Docker Desktop / WSL memory if assembly
 * steps fail at runtime.
 */

profiles {
    local {
        params {
            input  = null   // override on CLI: --input /path/to/sample_sheet.csv
            outdir = 'results'
        }

        process {
            executor = 'local'
            maxForks = 1    // one heavy process at a time given RAM constraints

            withLabel: 'process_single' {
                cpus   = 1
                memory = 4.GB
                time   = 4.h
            }
            withLabel: 'process_medium' {
                cpus   = 4
                memory = 6.GB
                time   = 12.h
            }
            withLabel: 'process_high' {
                cpus   = 4
                memory = 6.GB
                time   = 48.h
            }
            withLabel: 'process_high_memory' {
                cpus   = 4
                memory = 6.GB
                time   = 72.h
            }
        }

        docker {
            enabled    = true
            runOptions = '--memory=6g --cpus=4'
        }
    }
}
