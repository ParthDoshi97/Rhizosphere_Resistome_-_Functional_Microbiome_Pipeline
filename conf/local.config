/*
 * Local / WSL execution profile
 * Machine: 12 CPUs, ~14 GB RAM
 * Runs processes sequentially (no cloud parallelism).
 * Use subsampled reads for dev/testing to keep runtimes manageable.
 */

profiles {
    local {
        params {
            input  = null   // override on CLI: --input /path/to/sample_sheet.csv
            outdir = 'results'
        }

        process {
            executor = 'local'
            maxForks = 1    // one heavy process at a time given RAM constraints

            withLabel: 'process_single' {
                cpus   = 1
                memory = 4.GB
                time   = 4.h
            }
            withLabel: 'process_medium' {
                cpus   = 4
                memory = 8.GB
                time   = 12.h
            }
            withLabel: 'process_high' {
                cpus   = 10
                memory = 12.GB
                time   = 48.h
            }
            withLabel: 'process_high_memory' {
                cpus   = 10
                memory = 12.GB
                time   = 72.h
            }
        }

        docker {
            enabled    = true
            runOptions = '--memory=12g --cpus=10'
        }
    }
}
