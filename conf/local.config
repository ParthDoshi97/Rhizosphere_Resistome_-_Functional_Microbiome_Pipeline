/*
 * Local / WSL execution profiles.
 *
 * These profiles are conservative for laptops where Docker/WSL exposes around
 * 6-7 GB RAM. The executor queue cap is important: maxForks limits instances
 * per process, while queueSize keeps different heavy processes from running at
 * the same time.
 *
 * S3 reduces local storage pressure, but it does not increase RAM. Use the
 * AWS Batch profiles when assembly needs more memory than WSL can provide.
 */

profiles {
    local {
        params {
            input  = null   // override on CLI: --input /path/to/sample_sheet.csv
            outdir = 'results'
        }

        executor {
            queueSize = 1
        }

        process {
            executor = 'local'
            maxForks = 1

            withLabel: 'process_single' {
                cpus   = 1
                memory = 4.GB
                time   = 4.h
            }
            withLabel: 'process_medium' {
                cpus   = 4
                memory = 6.GB
                time   = 12.h
            }
            withLabel: 'process_high' {
                cpus   = 4
                memory = 6.GB
                time   = 48.h
            }
            withLabel: 'process_high_memory' {
                cpus   = 4
                memory = 6.GB
                time   = 72.h
            }
        }

        docker {
            enabled    = true
            runOptions = '--memory=6g --cpus=4'
        }
    }

    local_s3 {
        params {
            input  = System.getenv('NXF_S3_INPUT') ?: 's3://nf-pipeline-data/Data/sample_sheet.csv'
            outdir = System.getenv('NXF_S3_OUTDIR') ?: 's3://nf-pipeline-data/Data/PRJNA647806/results'
            aws_region = System.getenv('AWS_REGION') ?: System.getenv('AWS_DEFAULT_REGION') ?: 'ap-south-1'
        }

        executor {
            queueSize = 1
        }

        process {
            executor = 'local'
            maxForks = 1

            withLabel: 'process_single' {
                cpus   = 1
                memory = 4.GB
                time   = 4.h
            }
            withLabel: 'process_medium' {
                cpus   = 4
                memory = 6.GB
                time   = 12.h
            }
            withLabel: 'process_high' {
                cpus   = 4
                memory = 6.GB
                time   = 48.h
            }
            withLabel: 'process_high_memory' {
                cpus   = 4
                memory = 6.GB
                time   = 72.h
            }
        }

        docker {
            enabled    = true
            runOptions = '--memory=6g --cpus=4'
        }

        aws {
            region = params.aws_region
        }
    }
}
